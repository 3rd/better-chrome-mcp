{
  "name": "better-chrome-mcp",
  "version": "0.0.0",
  "description": "Chrome browser automation and diagnostics for MCP clients.",
  "private": true,
  "type": "module",
  "imports": {
    "#fastmcp": {
      "types": "fastmcp",
      "default": "fastmcp"
    }
  },
  "bin": {
    "better-chrome-mcp": "./dist/index.ts"
  },
  "files": [
    "dist",
    "patches",
    "README.md",
    "SETUP.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test ./src",
    "test:live": "bun scripts/live-test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "bun scripts/clean.mjs",
    "build": "bun scripts/build.ts",
    "smoke:source": "bun scripts/smoke.mjs bun src/index.ts",
    "smoke": "bun scripts/smoke.mjs bun dist/index.ts",
    "prepack": "bun run build",
    "verify": "bun run test && bun run typecheck && bun run smoke:source && bun run build && bun run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@standard-schema/spec": "1.1.0",
    "happy-dom": "20.11.6",
    "lighthouse": "13.3.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "puppeteer-core": "24.43.1",
    "react": "19.2.8",
    "react-devtools-inline": "7.0.1",
    "react-dom": "19.2.8",
    "react-is": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/bun": "1.4.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "chrome-devtools-frontend": "1.0.1708524",
    "fastmcp": "4.15.1",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "chrome-devtools-frontend@1.0.1708524": "patches/chrome-devtools-frontend@1.0.1708524.patch",
    "fastmcp@4.15.1": "patches/fastmcp@4.15.1.patch"
  }
}
